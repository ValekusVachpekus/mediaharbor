{
  "name": "mediaharbor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/extension",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @mediaharbor/desktop",
    "build": "npm run build -w @mediaharbor/desktop",
    "check": "tsc --noEmit",
    "test": "node tests/import.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:dom": "node tests/dom-smoke.mjs",
    "test:extension": "node tests/extension-smoke.mjs",
    "extension:portable": "node scripts/build-extension.mjs",
    "desktop": "npm run tauri -w @mediaharbor/desktop -- dev",
    "bundle": "npm run tauri -w @mediaharbor/desktop -- build",
    "installers": "node scripts/installers.mjs",
    "installers:check": "node scripts/installers.mjs --check",
    "extension:chrome": "npm run build -w @mediaharbor/extension",
    "extension:firefox": "npm run build:firefox -w @mediaharbor/extension"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.12",
    "jsdom": "25.0.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  }
}
